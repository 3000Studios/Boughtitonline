{% comment %}
  TD Flash — Instant Deal Command Bar
  TODAYS DEALS · todaysdeals.gumroad.com
  Drop this file into /sections and add the section in the theme editor.
{% endcomment %}

{%- liquid
  assign ends = section.settings.ends_at | default: ''
  assign href = section.settings.cta_url | default: routes.all_products_collection_url
-%}

<style>
  #td-flash-{{ section.id }} {
    --td-bg: {{ section.settings.bg }};
    --td-fg: {{ section.settings.fg }};
    --td-accent: {{ section.settings.accent }};
    --td-font: {{ section.settings.font_stack }};
    position: relative;
    z-index: 40;
    width: 100%;
    background: var(--td-bg);
    color: var(--td-fg);
    font-family: var(--td-font);
    border-bottom: 1px solid color-mix(in srgb, var(--td-accent) 35%, transparent);
  }
  #td-flash-{{ section.id }}[hidden] { display: none !important; }
  #td-flash-{{ section.id }} .td-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    min-height: 52px;
  }
  #td-flash-{{ section.id }} .td-kicker {
    letter-spacing: 0.22em;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--td-accent);
  }
  #td-flash-{{ section.id }} .td-msg {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  #td-flash-{{ section.id }} .td-clock {
    display: inline-flex;
    gap: 6px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: 13px;
  }
  #td-flash-{{ section.id }} .td-unit {
    background: color-mix(in srgb, var(--td-accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--td-accent) 40%, transparent);
    color: var(--td-accent);
    min-width: 42px;
    text-align: center;
    padding: 4px 6px;
    border-radius: 6px;
  }
  #td-flash-{{ section.id }} .td-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--td-accent);
    color: #111;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: 999px;
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  #td-flash-{{ section.id }} .td-cta:hover { transform: translateY(-1px); filter: brightness(1.06); }
  #td-flash-{{ section.id }} .td-x {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: 0;
    color: var(--td-fg);
    opacity: 0.55;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
  }
  @media (max-width: 749px) {
    #td-flash-{{ section.id }} .td-x { position: static; transform: none; }
    #td-flash-{{ section.id }} .td-inner { padding-right: 16px; }
  }
</style>

<div
  id="td-flash-{{ section.id }}"
  role="region"
  aria-label="{{ section.settings.kicker | escape }}"
  data-td-flash
  data-ends="{{ ends | escape }}"
  data-dismiss="td-flash-{{ section.id }}"
>
  <div class="td-inner">
    <span class="td-kicker">{{ section.settings.kicker | escape }}</span>
    <span class="td-msg">{{ section.settings.message | escape }}</span>
    <span class="td-clock" data-td-clock aria-live="polite">
      <span class="td-unit" data-h>00h</span>
      <span class="td-unit" data-m>00m</span>
      <span class="td-unit" data-s>00s</span>
    </span>
    <a class="td-cta" href="{{ href }}">{{ section.settings.cta_label | escape }}</a>
    {%- if section.settings.dismissible -%}
      <button class="td-x" type="button" data-td-close aria-label="Dismiss">×</button>
    {%- endif -%}
  </div>
</div>

<script>
(function () {
  var root = document.getElementById("td-flash-{{ section.id }}");
  if (!root) return;
  var key = root.getAttribute("data-dismiss");
  try {
    if (sessionStorage.getItem(key) === "1") {
      root.hidden = true;
      return;
    }
  } catch (e) {}

  var close = root.querySelector("[data-td-close]");
  if (close) {
    close.addEventListener("click", function () {
      root.hidden = true;
      try { sessionStorage.setItem(key, "1"); } catch (e) {}
    });
  }

  var ends = root.getAttribute("data-ends");
  var clock = root.querySelector("[data-td-clock]");
  if (!ends || !clock) return;
  var target = Date.parse(ends);
  if (!target) return;

  function pad(n) { return String(n).padStart(2, "0"); }
  function tick() {
    var left = Math.max(0, target - Date.now());
    var s = Math.floor(left / 1000);
    var h = Math.floor(s / 3600);
    s -= h * 3600;
    var m = Math.floor(s / 60);
    s -= m * 60;
    clock.querySelector("[data-h]").textContent = pad(h) + "h";
    clock.querySelector("[data-m]").textContent = pad(m) + "m";
    clock.querySelector("[data-s]").textContent = pad(s) + "s";
    if (left <= 0) {
      root.hidden = true;
      clearInterval(timer);
    }
  }
  tick();
  var timer = setInterval(tick, 1000);
})();
</script>

{% schema %}
{
  "name": "TD Flash Deal Bar",
  "class": "td-flash-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "TODAY ONLY" },
    { "type": "text", "id": "message", "label": "Message", "default": "Member pricing is live. Don’t wait." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop the drop" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "ends_at", "label": "Ends at (ISO, e.g. 2026-12-31T23:59:00)", "default": "2026-12-31T23:59:00" },
    { "type": "checkbox", "id": "dismissible", "label": "Allow dismiss", "default": true },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0a0a0a" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#f4f1ea" },
    { "type": "color", "id": "accent", "label": "Gold", "default": "#f5c400" },
    { "type": "text", "id": "font_stack", "label": "Font stack", "default": "Inter, ui-sans-serif, system-ui, sans-serif" }
  ],
  "presets": [
    { "name": "TD Flash Deal Bar" }
  ]
}
{% endschema %}
